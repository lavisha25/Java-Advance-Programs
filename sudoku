class Solution {
    public void solveSudoku(char[][] board) {
        sudoku(board,0,0);
    }
    private boolean isSafe(char[][] board,int r,int c,int dig){
        //horizontal
        for(int i=0;i<9;i++){
            char ch=(char)(dig+'0');
            if(board[i][c]==ch) return false;
        }
        for(int i=0;i<9;i++){
            char ch=(char)(dig+'0');
            if(board[r][i]==ch) return false;
        }
        //grid
        int sr=(r/3)*3;
        int sc=(c/3)*3;
        for(int i=sr;i<sr+3;i++){
            for(int j=sc;j<sc+3;j++){
                char ch=(char)(dig+'0');
                if(board[i][j]==ch) return false;
            }
        }
        return true;
    }
    public boolean sudoku(char[][] board,int r,int c){
        if(r==9) return true;
        int nr=r;
        int nc=c+1;
        if(nc==9){
            nr=r+1;
            nc=0;
        }
        if(board[r][c]!='.'){
           return sudoku(board,nr,nc);
        }
        for(int i=1;i<=9;i++){
            if(isSafe(board,r,c,i)){
                board[r][c]=(char)(i+'0');
                if(sudoku(board,nr,nc)) return true;
                board[r][c]='.';
            }
        }
        return false;
    }
}
